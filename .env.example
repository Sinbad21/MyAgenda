# ──────────────────────────────────────────────────────────────
# MyAgenda – variabili d'ambiente (copia in .env e compila)
# ──────────────────────────────────────────────────────────────

# Percorso del file SQLite (default: ./data/myagenda.db)
DATABASE_PATH=./data/myagenda.db

# Segreto per firmare i JWT delle sessioni (httpOnly cookie).
# Genera con: openssl rand -base64 32
AUTH_SECRET=change-me-with-a-long-random-string

# ── Login con Google (OAuth) ───────────────────────────────────
# Opzionale: se vuoti, il pulsante "Continua con Google" non viene mostrato.
# Crea le credenziali su https://console.cloud.google.com → API e servizi →
# Credenziali → ID client OAuth → Applicazione web.
# URI di reindirizzamento autorizzati da registrare:
#   http://localhost:3000/api/auth/google/callback   (dev)
#   https://<tuo-dominio>/api/auth/google/callback    (prod)
# Su Cloudflare Pages: metti questi valori in .dev.vars (locale) e nelle
# variabili d'ambiente del progetto Pages (produzione).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Chat AI (LLM) ──────────────────────────────────────────────
# Provider: anthropic (default). La chiave è opzionale: senza chiave
# la chat usa un parser interno di fallback (regole) per la demo.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modello Claude da usare (configurabile). Default: claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8

# ── Web Push (VAPID) ───────────────────────────────────────────
# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@esempio.it

# ── Email (SMTP transazionale: Resend/SendGrid/Mailtrap/…) ─────
# Lasciare vuoto per disabilitare l'invio reale (le email vengono loggate).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MyAgenda <no-reply@myagenda.app>

# ── Cron / job scheduling ──────────────────────────────────────
# Segreto richiesto per chiamare /api/cron (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-cron-secret
# Su Cloudflare Pages i cron trigger NON esistono: il Worker in
# workers/reminder-cron chiama /api/cron ogni minuto (vedi suo README).

# ── Notifiche promemoria (orari) ───────────────────────────────
# Fuso orario usato per far scattare gli appuntamenti all'ora giusta.
APP_TIMEZONE=Europe/Rome
# Minuti di anticipo sull'orario dell'appuntamento (0 = all'ora esatta).
REMINDER_LEAD_MINUTES=0
# Tolleranza (minuti) per notificare anche se il cron è in ritardo.
REMINDER_GRACE_MINUTES=120
# Ora (0-23) in cui inviare i promemoria "a giornata" (senza orario).
REMINDER_MORNING_HOUR=8
# URL pubblico dell'app usato nei link delle notifiche/email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pubblico dell'app (usato nelle email)
APP_URL=http://localhost:3000
